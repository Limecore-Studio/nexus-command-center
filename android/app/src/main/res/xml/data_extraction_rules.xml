<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.22 (limecore#99). Android 12+ copies app data during device-to-device
  transfer even with allowBackup="false". Nothing of NCC's is portable that
  way: the WebView database, the session and the PIN hash all stay on this
  device. The account's data comes back from sync on the new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
