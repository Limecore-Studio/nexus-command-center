{
  "name": "nexus-dashboard",
  "version": "1.17.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:ime": "node scripts/check-ime.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "check:desktop-paths": "node scripts/check-desktop-paths.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/check-ime.mjs && eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "icons": "node scripts/build-icons.mjs && capacitor-assets generate --android",
    "electron:dev": "electron .",
    "electron:build": "npm run build && node electron/build.cjs --win --publish never && npm run check:desktop-paths"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@devmaxime/capacitor-health-connect": "^1.1.0",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.7.7",
    "dexie": "^4.0.8",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.2",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.limecore.nexus.desktop",
    "productName": "Nexus Command Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/node_modules/**/{android,ios}/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "resources/installer.nsh",
      "artifactName": "NexusCommandCenter-Desktop-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Limekana",
        "repo": "nexus-command-center"
      }
    ]
  }
}